! UKS def2-TZVP NoRIJCOSX DefGrid3 TightSCF
%method
  method dft
  exchange hyb_mgga_x_mn15
  correlation mgga_c_mn15
  SpecialGridAtoms 26
  SpecialGridIntAcc 7
end
%pal nprocs 16 end
%maxcore 3000
%scf MaxIter 500 end
%basis
  NewGTO Fe "CP(PPP)" end
end
* xyzfile 0 4 syn_geom.xyz

%eprnmr
  Nuclei = all Fe {rho, fgrad}
end
