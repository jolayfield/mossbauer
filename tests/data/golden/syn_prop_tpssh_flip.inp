! UKS TPSSh def2-TZVP NoRIJCOSX DefGrid3 TightSCF
%method
  SpecialGridAtoms 26
  SpecialGridIntAcc 7
end
%pal nprocs 16 end
%maxcore 3000
%scf
  MaxIter 500
  FlipSpin 3, 4
  FinalMs 1.5
end
%basis
  NewGTO Fe "CP(PPP)" end
end
* xyzfile 0 6 syn_geom.xyz

%eprnmr
  Nuclei = all Fe {rho, fgrad}
end
